{
  "name": "api-test-devops-portfolio",
  "private": true,
  "scripts": {
    "lint:md": "markdownlint '**/*.md' '.claude/**/*.md' --ignore-path .markdownlintignore",
    "lint:md:fix": "markdownlint '**/*.md' '.claude/**/*.md' --ignore-path .markdownlintignore --fix",
    "lint:text": "textlint '**/*.md' --ignore-path .textlintignore",
    "lint:text:fix": "textlint '**/*.md' --ignore-path .textlintignore --fix",
    "lint:links": "git ls-files -z '*.md' | xargs -0 -I {} markdown-link-check ./{} --config .markdown-link-check.json --quiet",
    "lint:links:verbose": "git ls-files -z '*.md' | xargs -0 -I {} markdown-link-check ./{} --config .markdown-link-check.json",
    "lint:all": "npm run lint:md && npm run lint:text",
    "lint:all:fix": "npm run lint:md:fix && npm run lint:text:fix"
  },
  "devDependencies": {
    "@mixedbread/mgrep": "^0.1.13",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli": "^0.49.1",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2"
  },
  "overrides": {
    "basic-ftp": "^5.3.1",
    "path-to-regexp": "^8.4.0"
  }
}
